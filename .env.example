# Copy to .env to change a default. Nothing here is required: the DDB's
# version 2 API, the Landesarchiv Baden-Württemberg's online finding aids and
# the Archive in NRW portal need no key and no account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/german-archives-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so an archive
# can reach you if your use ever causes it trouble.
# GERMAN_ARCHIVES_CONTACT=you@example.org

# Optional: directory for the on-disk response cache.
# GERMAN_ARCHIVES_CACHE_DIR=~/.cache/german-archives-mcp

# Optional: HTTP timeout in seconds for one request (default 30; image
# downloads get 120 to read).
# GERMAN_ARCHIVES_TIMEOUT=30

# Optional: least seconds between two requests to one host (default 2, never
# below 2). The Archive in NRW portal's searches always wait at least 10.
# GERMAN_ARCHIVES_MIN_INTERVAL=2

# Optional: an existing folder that every labw_image or nrw_image destination
# must lie inside. They never write under ~/Library otherwise; set this to save
# into an iCloud Drive folder, which lives there.
# GERMAN_ARCHIVES_DOWNLOAD_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Genealogy"
